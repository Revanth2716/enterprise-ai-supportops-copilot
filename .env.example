# ==========================================
# Enterprise AI SupportOps Copilot - Environment
# ==========================================

# Environment Mode
APP_ENV=development
LOG_LEVEL=INFO

# Application API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL Database (with pgvector)
# Local Docker or Postgres instance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supportops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/supportops

# Redis (Short-lived state / caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Provider Settings (Default: zero-cost mock)
# Options: mock | ollama | openai
AI_PROVIDER=mock
AI_MODEL=supportops-mock-v1

# Optional: Ollama settings (Local open-source)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# Optional: OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings (Default: fastembed local CPU model)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001
MCP_ENABLED=true
